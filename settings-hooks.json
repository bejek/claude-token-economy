{
  "_comment": "Token Economy Kit — hooks blok ke SLOUČENÍ do ~/.claude/settings.json. NAHRAĎ <CLAUDE_DIR> absolutní cestou k ~/.claude (na Windows použij lomítka /, např. C:/Users/pepa/.claude). Nepřepisuj existující settings.json — slučuj do pole u každé události. Klíč _comment před vložením smaž.",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/inject_session_ledger.py",
            "timeout": 10
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/context_size_warning.py",
            "timeout": 15
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_runaway_loop.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_read_before_search.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_agent_model_routing.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_workflow_model_routing.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_spawn_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_heavy_skill_delegation.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_session_ledger.py",
            "timeout": 10
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/context_size_warning.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/guard_session_ledger.py",
            "timeout": 10
          }
        ]
      }
    ],

    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python <CLAUDE_DIR>/scripts/post_compact_context.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
